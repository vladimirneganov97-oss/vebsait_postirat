<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>График стирки</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header>
    <div class="wrap nav">
        <a class="brand" asp-controller="Home" asp-action="Index">🧺 Постирочная</a>
        <nav>
            <a asp-controller="Home" asp-action="Index">График</a>
            @if (Context.Session.GetString("UserName") != null)
            {
                <span class="user">@(Context.Session.GetString("UserName")) · комната @(Context.Session.GetString("Room")) · ID @(Context.Session.GetString("UserPublicId"))</span>
                <a asp-controller="Account" asp-action="Logout">Выйти</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Войти</a><a asp-controller="Account" asp-action="Register">Регистрация</a>
            }
            <a asp-controller="Admin" asp-action="Login">Админка</a>
        </nav>
    </div>
</header>
<main class="wrap">@RenderBody()</main>
<footer class="security-footer">Пароли хранятся в базе в виде хэшей. Подключение по HTTP в локальной сети не шифрует передаваемые данные; для шифрования трафика нужен HTTPS.</footer>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>